# Examples only. Local Python does not load this file automatically.
# python serve.py uses storage/ressoa.sqlite3 by default.
# Production Render + Neon (set secrets in the Render dashboard, never in Git):
RESSOA_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ORIGIN=https://seu-endereco.example
# In Render, APP_ORIGIN is inferred from RENDER_EXTERNAL_HOSTNAME.
# Set APP_ORIGIN explicitly when using a custom domain.
