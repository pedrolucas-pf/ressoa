# Examples only. Local Python does not load this file automatically.
# python serve.py uses storage/ressoa.sqlite3 by default.
# Production Render + Neon (set secrets in the Render dashboard, never in Git):
RESSOA_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_ORIGIN=https://seu-endereco.example
# In Render, APP_ORIGIN is inferred from RENDER_EXTERNAL_HOSTNAME.
# Set APP_ORIGIN explicitly when using a custom domain.
# Password recovery: create a Brevo API key and verify the sender address first.
# Set these secrets only in Render's Environment settings; never commit real values.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Ressoa
# Optional: content value or full HTML tag from Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Optional Spotify connection: public Client ID; PKCE does not use a Client Secret.
SPOTIFY_CLIENT_ID=
